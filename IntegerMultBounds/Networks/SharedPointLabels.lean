module

public import IntegerMultBounds.Networks.Labels

/-! Nondegenerate source labels for shared-point triple families. The labels
are the actual spans of supported indicator vectors, not chosen abstract
nondegenerate subspaces. The argument works even when the ambient rational
form is degenerate (ambient dimension nine). -/

@[expose] public section

namespace IntegerMultBounds.Networks.SharedPointLabels

open Labels

variable {h : ℕ}

/-- Source labels are generated by precisely the supported triple indicators.
A set-valued support also covers arbitrary finite indexed source families. -/
def sourceSpan (support : Set (Finset (Fin h))) : Submodule ℚ (Fin h → ℚ) :=
  Submodule.span ℚ ((fun S => (indicator S : Fin h → ℚ)) '' support)

/-- Enlarging the actual source support enlarges its generated label space. -/
theorem sourceSpan_mono {support larger : Set (Finset (Fin h))} (hs : support ⊆ larger) :
    sourceSpan support ≤ sourceSpan larger :=
  Submodule.span_mono (Set.image_mono hs)

/-- Every shared-point triple has coordinate sum three times its common entry. -/
def sharedPlane (common : Fin h) : Submodule ℚ (Fin h → ℚ) where
  carrier := {x | (∑ i, x i) = 3 * x common}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_ofPred_eq, Pi.add_apply, Finset.sum_add_distrib] at hx hy ⊢
    rw [hx, hy]
    ring
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum] at hx ⊢
    rw [hx]
    ring

@[simp] theorem mem_sharedPlane (common : Fin h) (x : Fin h → ℚ) :
    x ∈ sharedPlane common ↔ (∑ i, x i) = 3 * x common := Iff.rfl

theorem sourceSpan_le_sharedPlane (common : Fin h) (support : Set (Finset (Fin h)))
    (htriples : ∀ S ∈ support, S.card = 3)
    (hcommon : ∀ S ∈ support, common ∈ S) :
    sourceSpan support ≤ sharedPlane common := by
  apply Submodule.span_le.mpr
  rintro x ⟨S, hS, rfl⟩
  simp [mem_sharedPlane, htriples S hS, indicator, hcommon S hS]

/-- The negative rank-one correction cancels exactly the common coordinate. -/
theorem quadratic_eq (common : Fin h) (x : Fin h → ℚ) (hx : x ∈ sharedPlane common) :
    rational h x x = ∑ i ∈ Finset.univ.erase common, (x i) ^ 2 := by
  have hs : (∑ i, x i) = 3 * x common := hx
  have ht := Finset.sum_erase_add (Finset.univ : Finset (Fin h))
    (fun i => (x i) ^ 2) (Finset.mem_univ common)
  simp only [rational, form_apply, hs, ← pow_two]
  nlinarith

/-- Vanishing of the outside squares forces the whole vector to vanish:
the shared-point linear relation also kills its common coordinate. -/
theorem quadratic_eq_zero (common : Fin h) (x : Fin h → ℚ) (hx : x ∈ sharedPlane common)
    (hz : rational h x x = 0) : x = 0 := by
  have hs : (∑ i, x i) = 3 * x common := hx
  rw [quadratic_eq common x hx] at hz
  have hout (i : Fin h) (hi : i ≠ common) : x i = 0 := by
    have hle := Finset.single_le_sum (fun j (_ : j ∈ Finset.univ.erase common) => sq_nonneg (x j))
      (show i ∈ Finset.univ.erase common by simp [hi])
    nlinarith [sq_nonneg (x i)]
  have hsum : (∑ i, x i) = x common := by
    apply Finset.sum_eq_single common
    · intro i _ hi
      exact hout i hi
    · simp
  rw [hsum] at hs
  have hc : x common = 0 := by linarith
  funext i
  by_cases hi : i = common
  · subst i; exact hc
  · exact hout i hi

/-- Any actual subspace of this plane inherits nondegeneracy. -/
theorem subspace_nondegenerate (common : Fin h) (W : Submodule ℚ (Fin h → ℚ))
    (hW : W ≤ sharedPlane common) : ((rational h).restrict W).Nondegenerate := by
  constructor
  · intro x hx
    apply Subtype.ext
    exact quadratic_eq_zero common x (hW x.property) (hx x)
  · intro x hx
    apply Subtype.ext
    exact quadratic_eq_zero common x (hW x.property) (hx x)

/-- A finite indexed source family induces exactly its supported source span. -/
def indexedSpan {ι : Type*} (triples : ι → Finset (Fin h)) (support : Set ι) :
    Submodule ℚ (Fin h → ℚ) := sourceSpan (triples '' support)

theorem indexedSpan_mono {ι : Type*} (triples : ι → Finset (Fin h))
    {support larger : Set ι} (hs : support ⊆ larger) :
    indexedSpan triples support ≤ indexedSpan triples larger :=
  sourceSpan_mono (Set.image_mono hs)

end IntegerMultBounds.Networks.SharedPointLabels
