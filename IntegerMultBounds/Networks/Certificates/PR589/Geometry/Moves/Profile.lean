module

public import IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves.SectionD
public import IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves.SectionA
public import IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves.SectionB
public import IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves.SectionC
public import IntegerMultBounds.Networks.Certificates.PR589.Frames.Replay
public import IntegerMultBounds.Networks.Certificates.PR589.Geometry.CopyRanks

/-! The local MOVE profile of the selected PR589 word: every phase and final-alignment
incidence is a nested frame pair, its rank is the certified dimension difference,
and the positive ranks with the nine COPY ranks give the upstream local histogram.
Generated by scripts/generate_pr589_moves.py from pinned PR589 data. -/
@[expose] public section
namespace IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves

/-- Every phase incidence in execution order: D and A from the initial frames, then B and C
from the scatter boundary. Scatter itself is the separate COPY boundary. -/
def phaseEdges : List (ℕ × ℕ) :=
  Frames.edges (sectionD ++ sectionA) (Frames.snapshot Frames.initialRefs) ++
    Frames.edges (sectionB ++ sectionC) (Frames.scatterFinish Frames.beforeScatter)

def phaseValues : List ℕ := valuesD ++ valuesA ++ valuesB ++ valuesC

theorem phaseEdges_eq : phaseEdges =
    Frames.edges sectionD (Frames.snapshot Frames.before000) ++
      Frames.edges sectionA (Frames.snapshot Frames.before005) ++
    (Frames.edges sectionB (Frames.snapshot Frames.before097) ++
      Frames.edges sectionC (Frames.snapshot Frames.before127)) := by
  rw [phaseEdges, Frames.edges_append, Frames.edges_append, Frames.initial_link, Frames.scatter_link,
    Frames.checkedD, Frames.checkedB,
    show Frames.snapshot Frames.after004 = Frames.snapshot Frames.before005 from rfl,
    show Frames.snapshot Frames.after126 = Frames.snapshot Frames.before127 from rfl]

theorem phase_checked : ∀ p ∈ phaseEdges, CheckedPair p := by
  rw [phaseEdges_eq]
  simp only [List.forall_mem_append]
  exact ⟨⟨checkedD, checkedA⟩, checkedB, checkedC⟩

theorem phase_values : phaseEdges.map value = phaseValues := by
  rw [phaseEdges_eq]
  simp only [List.map_append, valuesD_eq, valuesA_eq, valuesB_eq, valuesC_eq, phaseValues,
    List.append_assoc]

/-- The rank of every phase incidence is the certified dimension difference. -/
theorem phase_ranks : phaseEdges.map (fun p => moveRank p.1 p.2) = phaseValues :=
  (profile _ phase_checked).trans phase_values

theorem phase_length : phaseValues.length = 29250 := by decide +kernel

theorem phase_histogram : (List.range 9).map phaseValues.count = [26339, 1323, 1342, 79, 44, 102, 11, 10, 0] := by
  decide +kernel

theorem final_checked : (∀ p ∈ Frames.finalEdges, CheckedPair p) ∧
    Frames.finalEdges.map value = List.replicate 661 0 := by
  decide +kernel

/-- Final alignment pays no rank: every final incidence has rank zero. -/
theorem final_ranks : Frames.finalEdges.map (fun p => moveRank p.1 p.2) = List.replicate 661 0 :=
  (profile _ final_checked.1).trans final_checked.2

/-- The ranks of the nine retained COPY operators. -/
noncomputable def copyRanks : List ℕ :=
  [510, 511, 512, 513, 514, 515, 516, 517, 518].map fun i => Module.finrank ℚ (LinearMap.range (-projector i))

theorem copyRanks_eq : copyRanks = List.replicate 9 7 := by
  simp only [copyRanks, List.map_cons, List.map_nil, copy_rank510, copy_rank511, copy_rank512, copy_rank513, copy_rank514, copy_rank515, copy_rank516, copy_rank517, copy_rank518]
  rfl

/-- The local paid profile: the positive MOVE ranks of the phase incidences, then the nine
COPY ranks. -/
noncomputable def localPaid : List ℕ :=
  (phaseEdges.map fun p => moveRank p.1 p.2).filter (· ≠ 0) ++ copyRanks

/-- The local paid histogram `{1:1323, 2:1342, 3:79, 4:44, 5:102, 6:11, 7:19}`, as recorded in
the selected tuned word's `EXPECTED.json` (`word.local_histogram`). -/
theorem localPaid_histogram : (List.range 9).map localPaid.count = [0, 1323, 1342, 79, 44, 102, 11, 19, 0] := by
  rw [localPaid, phase_ranks, copyRanks_eq]
  decide +kernel

end IntegerMultBounds.Networks.Certificates.PR589.Geometry.Moves
