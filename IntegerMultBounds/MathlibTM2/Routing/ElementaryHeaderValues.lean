module

public import IntegerMultBounds.MathlibTM2.Routing.ElementaryLoopData
public import IntegerMultBounds.MathlibTM2.Routing.BinaryPower
public import IntegerMultBounds.MathlibTM2.Routing.BinaryScale
public import IntegerMultBounds.MathlibTM2.Routing.BinaryTriple
public import IntegerMultBounds.MathlibTM2.Routing.BinaryNonempty

/-! Explicit arithmetic targets for the elementary instruction compiler. -/

@[expose] public section
namespace IntegerMultBounds.MathlibTM2.Routing

open IntegerMultBounds.MathlibTM2.Host

/-- Elementary swaps need a shifted row count, one power of two, three times
record width and two zero-or-one words. No general interval arithmetic is needed. -/
theorem elementarySwapValues_eq {n : ℕ} (t : Fin n) (rows B : ℕ) :
    swapValues
      (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
        (elementarySwapSpec t).w rows B).1
      (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
        (elementarySwapSpec t).w rows B).2.1
      (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
        (elementarySwapSpec t).w rows B).2.2
      (elementarySwapSpec t).w (elementarySwapSpec t).w =
    ![rows * 2 ^ (n - (t.val + (elementarySwapSpec t).w)),
      2 ^ (t.val - (elementarySwapSpec t).w), 3 * B,
      (elementarySwapSpec t).w, (elementarySwapSpec t).w] := by
  rw [blockExchangeDimensions_eq n _ _ _ rows B (elementarySwapSpec t).separate]
  simp [swapValues, elementarySwapSpec]

/-- The generated power word has exactly the elementary gap header's value. -/
theorem elementaryGapHeader_value {n : ℕ} (t : Fin n) (rows B : ℕ) :
    Counter.value (binaryPowerBits (t.val - (elementarySwapSpec t).w)) =
      swapValues
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).1
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).2.1
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).2.2
        (elementarySwapSpec t).w (elementarySwapSpec t).w 1 := by
  rw [elementarySwapValues_eq, binaryPowerBits_value]
  rfl

/-- Shifting a canonical row counter produces precisely the outer-row header. -/
theorem elementaryRowHeader_value {n : ℕ} (t : Fin n) (rows B : ℕ)
    (bs : List Bool) (hv : Counter.value bs = rows) :
    Counter.value (List.replicate (n - (t.val + (elementarySwapSpec t).w)) false ++ bs) =
      swapValues
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).1
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).2.1
        (blockExchangeDimensions n (elementarySwapSpec t).a (elementarySwapSpec t).b
          (elementarySwapSpec t).w rows B).2.2
        (elementarySwapSpec t).w (elementarySwapSpec t).w 0 := by
  rw [elementarySwapValues_eq, binaryScale_value, hv]
  exact Nat.mul_comm _ _

/-- Both width headers are generated by testing the live coordinate tape. -/
theorem elementaryWidthHeader_value {n A : ℕ} (t : Fin n)
    (word : List (Fin (A + 4))) (hword : word.length = t.val) :
    Counter.value (binaryNonemptyBits word.head?.isSome) = (elementarySwapSpec t).w := by
  rw [binaryNonemptyBits_value]
  cases word with
  | nil => simp only [List.length_nil] at hword; simp [elementarySwapSpec, ← hword]
  | cons x xs =>
    have ht : t.val ≠ 0 := by simp only [List.length_cons] at hword; omega
    simp [elementarySwapSpec, ht]

end IntegerMultBounds.MathlibTM2.Routing
