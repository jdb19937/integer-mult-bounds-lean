module

public import IntegerMultBounds.MathlibTM2.Routing.SparsePatternComplete
public import IntegerMultBounds.MathlibTM2.Routing.RepairDescriptorBank

/-! The actual repair key descriptor has a complete ordered coordinate
specification. Coordinates are still data to be generated by the machine. -/

@[expose] public section
namespace IntegerMultBounds.MathlibTM2.Routing

open IntegerMultBounds.MathlibTM2.Layer.CompactGadget

variable (p : Par) (X : ℕ) (active : Fin p.n → Bool) (s : Fin p.n → SlotSource p X)

def repairKeyCoordinates := sparseCoordinateClose p.wy
  (sparsePatternCoordinates (N := p.wy) (posS p) (selectiveKeySources p X active s))

theorem repairKeyCoordinates_bound (hK : 0 < p.K) : ∀ j < p.n, posS p j < p.wy := by
  intro j hj
  have hh := Nat.mul_lt_mul_of_pos_right hj hK
  unfold posS Par.wy
  omega

theorem repairKeyCoordinates_ready (hK : 0 < p.K) (L : ℕ) (hwy : 0 < p.wy) (hfit : p.wy < 2 ^ L) :
    SparseCoordinatesReady L 0 (sparseCoordinateValues (repairKeyCoordinates p X active s)) :=
  sparseCoordinateClose_ready L p.wy hwy hfit _
    (sparsePatternCoordinates_ordered (posS p) (posS_mono hK) _ (repairKeyCoordinates_bound p hK))
    (sparsePatternCoordinates_bound (posS p) _ (repairKeyCoordinates_bound p hK))

theorem repairKeyCoordinates_indices (hG : 0 < p.G) (hK : 0 < p.K)
    (L : ℕ) (hwy : 0 < p.wy) (hfit : p.wy < 2 ^ L) :
    SparseSelectorRun.expand (sparseCoordinateRuns 0 (repairKeyCoordinates p X active s)) =
      (repairDescriptorIndices p X hG hK active s none).reverse := by
  exact sparsePatternComplete_indices L hwy hfit (posS p) (posS_mono hK)
    (selectiveKeySources p X active s) (repairKeyCoordinates_bound p hK)

end IntegerMultBounds.MathlibTM2.Routing
