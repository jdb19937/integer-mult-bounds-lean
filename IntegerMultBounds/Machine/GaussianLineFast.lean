/-! The Gaussian line machine with the quasi-linear multiply. Both multiplies
of a window term run `Schoenhage.fastMul` on the same twelve tapes as before,
with its block of 91 tapes appended to the bank; every other part is the
twenty-two-tape part of `GaussianLine`, extended over the block, which is
blank before and after every step (`line_hoareF`). -/

@[expose] public section

set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace IntegerMultBounds.Machine.GaussianLine

open OrderedSelect (inTape bg start flat inTape_repr bg_blank bg_left start_succ getD_map)
open TwosComplement (addMod)
open FixedMul (ruler result ruler_nonblank ruler_length)
open BinaryAccumulate (sumWord)
open BinaryDecrease (diffWord)
open Schoenhage (fastMul fastMul_hoare placeMul placeMul_hoare blk fmTime)
open FamilyPlacementAlphabet (extend_hoare)

section Segments

variable {a : ℕ}

