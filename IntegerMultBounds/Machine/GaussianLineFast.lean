/-- The multiply on tapes `0–6, 8–12`, output on `O1`. -/
noncomputable def mulReF := placeMul (n := 22) ![0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12] (by decide) (by norm_num) fastMul
/-- The multiply on tapes `0–5, 7–12`, output on `O2`. -/
noncomputable def mulImF := placeMul (n := 22) ![0, 1, 2, 3, 4, 5, 7, 8, 9, 10, 11, 12] (by decide) (by norm_num) fastMul

noncomputable def innerBodyF :=
  seq (seq (seq mulReF (extend (seg1 (a := 0)) 91)) mulImF) (extend (seg2 (a := 0)) 91)
noncomputable def innerLoopF := whileLoop innerBodyF (fun sy => decide (sy (Fin.castAdd 91 16) ≠ blank))
noncomputable def outerBodyF :=
  seq (seq (seq (seq innerLoopF (extend (partA (a := 0)) 91)) (extend (rewindLoop (a := 0)) 91))
    (extend (retRm (a := 0)) 91)) (extend (partC (a := 0)) 91)
/-- The Gaussian line machine with the quasi-linear multiply. -/
noncomputable def programF := whileLoop outerBodyF (fun sy => decide (sy (Fin.castAdd 91 0) ≠ blank))

noncomputable def bodyBoundF (w W : ℕ) : ℕ := 2 * (fmTime w + 30 * w + 100) + 4 * W + 10 * w + 60

theorem reads_append (v : Tapes 22 0) (i : Fin 22) :
    (v.append blk).reads (Fin.castAdd 91 i) = v.reads i := by
  simp [Tapes.reads, Tapes.append]

