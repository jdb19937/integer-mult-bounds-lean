/-- The line machine with the quasi-linear multiply: the same outputs as
`line_hoare`, the block blank before and after. -/
theorem line_hoareF (wtWords uWords : List (List Bool)) (s t m p w W : ℕ) (sW tW : List Bool)
    (pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc : ℤ)
    (hw : 1 ≤ w) (hpw : p ≤ w) (hwW : w ≤ W) (hwt : ∀ x ∈ wtWords, x.length = w)
    (hu : ∀ x ∈ uWords, x.length = w) (hwtl : wtWords.length = t * (2 * m + 1))
    (hul : 2 * (s + 2 * m + 1) ≤ uWords.length) (hst : s ≤ t) (hs : 0 < s)
    (hsv : Counter.value sW = s) (htv : Counter.value tW = t) (hsl : sW.length ≤ tW.length + 1) :
    HoareTime programF (fun v => v = (Y (a := 0) wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl 0 0).append blk)
      (fun v => v = (Y (a := 0) wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl t 0).append blk) (t * (outerBoundF p w W m tW.length + 2)) := by
  have hwne : ∀ k < t, wtWords.getD (k * (2 * m + 1) + 0) [] ≠ [] := by
    intro k hk h0
    have := getD_length wtWords w hwt (k * (2 * m + 1) + 0) (by rw [hwtl]; nlinarith)
    rw [h0] at this; simp at this; omega
  have h := while_chain_hoare outerBodyF (fun sy => decide (sy (Fin.castAdd 91 0) ≠ blank))
    (fun k => (Y (a := 0) wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl k 0).append blk)
    (fun _ => outerBoundF p w W m tW.length) t (fun k hk => outer_hoareF wtWords uWords s t m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pOut pRm pRW pCr pCs pCt pFc hw hpw hwW hwt hu hwtl hul hst hs hsv htv hsl k hk) (fun k hk => ?_) ?_
  · rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at h
    exact h
  · simp only [reads_append]
    simp only [Y, Tapes.reads, bank, ↓reduceIte, decide_eq_true_eq, ne_eq, Fin.isValue]
    have hlt : k * (2 * m + 1) + 0 < (wordRecs (a := 0) wtWords).length := by
      rw [wordRecs_length, hwtl]; nlinarith
    refine OrderedSelect.inTape_start _ _ hlt ?_ ?_
    · rw [wordRecs, getD_map]; simpa using hwne k hk
    · rw [wordRecs, getD_map]; exact ReturnOrigin.bits_nonblank _
  · simp only [reads_append]
    simp only [Y, Tapes.reads, bank, ↓reduceIte, decide_eq_false_iff_not, ne_eq, not_not, Fin.isValue]
    rw [show t * (2 * m + 1) + 0 = (wordRecs (a := 0) wtWords).length by rw [wordRecs_length, hwtl, Nat.add_zero]]
    exact OrderedSelect.inTape_end _

