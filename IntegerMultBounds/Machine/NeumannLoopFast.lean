  GaussianLine.programF

/-- One Neumann iteration with the quasi-linear line machine. -/
noncomputable def stepF := seq (seq (extend (preStep (a := 0)) 91) pg0F) (extend (postStep (a := 0)) 91)

/-- `p` iterations, counted by a ruler. -/
