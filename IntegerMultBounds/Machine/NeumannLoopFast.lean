      (fun v => v = Schoenhage.blkAppend (Z (a := 0) wt v0 s m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRx1 pRx2 pRk hw hpw hwW hwt hwtl hv0 hv0w hms hs hsv htv hsl p))
      (p * (stepBoundF s m p w W tW.length + 2)) := by
  have h := while_chain_hoare stepF (fun sy => decide (sy (Fin.castAdd 91 26) ≠ blank))
    (fun K => Schoenhage.blkAppend (Z (a := 0) wt v0 s m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRx1 pRx2 pRk hw hpw hwW hwt hwtl hv0 hv0w hms hs hsv htv hsl K))
    (fun _ => stepBoundF s m p w W tW.length) p
    (fun K _ => by
      obtain ⟨hyl, hyw⟩ := iter_shape wt v0 s m p w W hv0w K
      exact step_hoareF wt v0 s m p w W sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRx1 pRx2 pRk hw hpw hwW hwt hwtl hv0 hv0w hms hs hsv htv hsl (iter wt v0 s m p w W K) (by rw [hyl, hv0]) hyw K) (fun K hK => ?_) ?_
  · rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at h
    exact h
  · simp only [Schoenhage.blkAppend_reads]
    simp only [Z, Tapes.reads, bank, Fin.isValue, Fin.reduceEq, ↓reduceIte, decide_eq_true_eq, ne_eq]
    exact ruler_at pRk p K hK
  · simp only [Schoenhage.blkAppend_reads]
    simp only [Z, Tapes.reads, bank, Fin.isValue, Fin.reduceEq, ↓reduceIte, decide_eq_false_iff_not, not_not, ne_eq]
    exact ruler_end' pRk p

end Fast

