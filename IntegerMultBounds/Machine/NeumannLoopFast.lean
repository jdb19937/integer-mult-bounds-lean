/-- The extension of the iterate before the window sums. -/
def preStep := (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (pe1 (a := a)) pe2) pe3) pe4) pe5) pe6) pe7) pe8) pe9) pe10) pe11) pe12)
/-- The clean-up and subtraction after the window sums. -/
def postStep := (seq (seq (seq (seq (seq (seq (seq (seq (seq (seq (pg1 (a := a)) pg2) pg3) pg4) pg5) pg6) ps1) ph1) ph2) ph3) ph4)

/-- Everything of one iteration but the window sums. -/
