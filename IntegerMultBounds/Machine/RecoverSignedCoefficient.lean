module

public import IntegerMultBounds.Machine.RecoverPrecisionSplit

/-! A literal single-coefficient section 8 pipeline from a signed dyadic
numerator and two width rulers. Magnitude conversion, physical precision
splitting, rounding, raw-word conversion, and chunk/carry emission all execute
on the same bank. No prepared magnitude, fractional field, integer descriptor,
or correctly rounded coefficient is an input premise. Array iteration and
transform-record extraction/scaling remain separate. -/

@[expose] public section
namespace IntegerMultBounds.Machine.RecoverSignedCoefficient
variable {alphabet : ℕ}
open RecoverCarryStep (word sumBits)
open RecoverCoefficientRound (roundedBits)
open RecoverPrecisionSplit (fractionBits sourceBits)

def work (carryBits : List Bool) (chunkWidth : ℕ) : Tapes 7 alphabet :=
  (RecoverCarryStep.completeInput [] carryBits chunkWidth).append
    (⟨fun _ => 0,fun _ => fun _ => blank⟩ : Tapes 2 alphabet)

def input (signedLowBits : List Bool) (sign : Bool) (carryBits : List Bool)
    (chunkWidth precision : ℕ) : Tapes 9 alphabet :=
  (work carryBits chunkWidth).append
    (Copy.tapes (word (signedLowBits ++ [sign])) (word (List.replicate precision true))
      (signedLowBits ++ [sign]).length 0)

def output (signedLowBits : List Bool) (sign : Bool) (lowerBits integerBits carryBits : List Bool)
    (guard : Bool) (chunkWidth : ℕ) : Tapes 9 alphabet :=
  (RecoverCoefficientStep.output guard integerBits carryBits chunkWidth
    (BinaryDescriptorStack.descriptor (fractionBits lowerBits guard)) (fractionBits lowerBits guard).length).append
    (Copy.tapes (word (RecoverMagnitude.magnitude signedLowBits sign))
      (word (List.replicate (fractionBits lowerBits guard).length true))
      (RecoverMagnitude.magnitude signedLowBits sign).length (fractionBits lowerBits guard).length)

def magnitudeSlots : Fin (1+8) ≃ Fin 9 where
  toFun := ![7,0,1,2,3,4,5,6,8]
  invFun := ![1,2,3,4,5,6,7,0,8]
  left_inv := by decide
  right_inv := by decide

def splitSlots : Fin (4+5) ≃ Fin 9 where
  toFun := ![8,7,6,5,0,1,2,3,4]
  invFun := ![4,5,6,7,8,3,2,1,0]
  left_inv := by decide
  right_inv := by decide

def program : Program 9 49 alphabet :=
  seq (seq (reindex (extend RecoverMagnitude.program 8) magnitudeSlots)
    (reindex (extend RecoverPrecisionSplit.program 5) splitSlots))
    (extend RecoverCoefficientStep.program 2)

private theorem magnitude_bank (working : Tapes 7 alphabet) (bits : List Bool)
    (ruler : ℤ → Fin (alphabet+4)) (sourceHead rulerHead : ℤ) :
    ((RecoverMagnitude.one bits sourceHead).append
      (working.append (⟨fun _ => rulerHead,fun _ => ruler⟩ : Tapes 1 alphabet))).reindex magnitudeSlots =
      working.append (Copy.tapes (word bits) ruler sourceHead rulerHead) := by
  unfold RecoverMagnitude.one Tapes.append Tapes.reindex magnitudeSlots Copy.tapes Copy.cfg Config.tapes
  congr 1 <;> apply List.ofFn_injective <;> rfl

private theorem split_bank (carrying : Tapes 5 alphabet)
    (ruler source fraction integer : ℤ → Fin (alphabet+4))
    (rulerHead sourceHead fractionHead integerHead : ℤ) :
    ((RecoverPrecisionSplit.bank ruler source fraction integer rulerHead sourceHead fractionHead integerHead).append
      carrying).reindex splitSlots =
      (carrying.append (Copy.tapes integer fraction integerHead fractionHead)).append
        (Copy.tapes source ruler sourceHead rulerHead) := by
  unfold RecoverPrecisionSplit.bank Tapes.append Tapes.reindex splitSlots Copy.tapes Copy.cfg Config.tapes
  congr 1 <;> apply List.ofFn_injective <;> rfl

/-- Full physical signed-coefficient recovery with exact whole-bank output.
The layout equation identifies the bit fields of the computed magnitude; those
fields are generated by the machine, not supplied on input tapes. -/
theorem runs_signed (signedLowBits : List Bool) (sign : Bool)
    (lowerBits integerBits carryBits : List Bool) (guard : Bool) (coefficient chunkWidth : ℕ)
    (layout : RecoverMagnitude.magnitude signedLowBits sign = sourceBits lowerBits guard integerBits)
    (coefficientWidth : chunkWidth ≤ integerBits.length)
    (approximationClose : |(TwosComplement.signed (signedLowBits ++ [sign]) : ℝ) /
      2 ^ (lowerBits.length + 1) - coefficient| < 1 / 2) :
    HoareTime (program (alphabet := alphabet))
      (· = input signedLowBits sign carryBits chunkWidth (lowerBits.length + 1))
      (fun finalBank => finalBank = output signedLowBits sign lowerBits integerBits carryBits guard chunkWidth ∧
        Counter.value ((sumBits (roundedBits guard integerBits) carryBits).take chunkWidth) =
          (coefficient + Counter.value carryBits) % 2 ^ chunkWidth ∧
        Counter.value ((sumBits (roundedBits guard integerBits) carryBits).drop chunkWidth) =
          (coefficient + Counter.value carryBits) / 2 ^ chunkWidth)
      (13 * (signedLowBits ++ [sign]).length + 4 * carryBits.length + chunkWidth + 50) := by
  have magnitudeRun := hoare_place (RecoverMagnitude.runs_magnitude (alphabet := alphabet) signedLowBits sign)
    magnitudeSlots ((work carryBits chunkWidth).append
      (⟨fun _ => 0,fun _ => word (List.replicate (fractionBits lowerBits guard).length true)⟩ : Tapes 1 alphabet))
  rw [magnitude_bank,magnitude_bank] at magnitudeRun
  have emptyDescriptors : (⟨fun _ => 0,fun _ => fun _ => blank⟩ : Tapes 2 alphabet) =
      Copy.tapes (fun _ => blank) (fun _ => blank) 0 0 := by
    unfold Copy.tapes Copy.cfg Config.tapes
    congr 1 <;> apply List.ofFn_injective <;> rfl
  simp only [work] at magnitudeRun
  rw [emptyDescriptors] at magnitudeRun
  have splitRun := hoare_place (RecoverPrecisionSplit.runs_split (alphabet := alphabet) lowerBits guard integerBits)
    splitSlots (RecoverCarryStep.completeInput [] carryBits chunkWidth)
  unfold RecoverPrecisionSplit.input RecoverPrecisionSplit.output at splitRun
  rw [split_bank,split_bank,← layout] at splitRun
  have guardRead : BinaryDescriptorStack.descriptor (a := alphabet) (fractionBits lowerBits guard)
      (fractionBits lowerBits guard).length = bitSymbol guard := by
    have read := RecoverCoefficientRound.fractional_guard_read (alphabet := alphabet) lowerBits guard
    simpa only [fractionBits,List.length_append,List.length_cons,List.length_nil,Nat.cast_add,Nat.cast_one,
      Nat.cast_zero,zero_add,add_zero,add_comm] using read
  have coefficientRun := FamilyPlacementAlphabet.extend_hoare
    (RecoverCoefficientStep.runs_step guard integerBits carryBits chunkWidth
      (BinaryDescriptorStack.descriptor (fractionBits lowerBits guard)) (fractionBits lowerBits guard).length
      guardRead coefficientWidth)
    (Copy.tapes (word (RecoverMagnitude.magnitude signedLowBits sign))
      (word (List.replicate (fractionBits lowerBits guard).length true))
      (sourceBits lowerBits guard integerBits).length (fractionBits lowerBits guard).length)
  rw [← layout] at coefficientRun
  have stages := ((magnitudeRun.seq splitRun).seq coefficientRun)
  have unsignedMargin := RecoverMagnitude.split_magnitude_margin signedLowBits sign lowerBits integerBits
    guard coefficient layout approximationClose
  have values := RecoverCoefficientStep.step_values integerBits lowerBits carryBits guard coefficient chunkWidth
    coefficientWidth unsignedMargin
  apply stages.consequence
    (fun _ hypothesis => by simpa only [input,work,emptyDescriptors,fractionBits,List.length_append,List.length_cons,List.length_nil] using hypothesis)
    (fun _ hypothesis => ⟨by simpa only [output,layout] using hypothesis,values⟩)
  have widths : (signedLowBits ++ [sign]).length =
      (fractionBits lowerBits guard).length + integerBits.length := by
    rw [← RecoverMagnitude.magnitude_length signedLowBits sign,layout]
    simp [sourceBits]
  omega

/-- Recovery from the original signed word and precision only. The fields and
guard are derived from the computed magnitude, so no external layout equation
or prepared-field correctness certificate is required of the caller. -/
theorem runs_signed_exists (signedLowBits : List Bool) (sign : Bool) (carryBits : List Bool)
    (coefficient chunkWidth precision : ℕ) (precisionPositive : 0 < precision)
    (precisionFits : precision ≤ (signedLowBits ++ [sign]).length)
    (chunkFits : chunkWidth ≤ (signedLowBits ++ [sign]).length - precision)
    (approximationClose : |(TwosComplement.signed (signedLowBits ++ [sign]) : ℝ) /
      2 ^ precision - coefficient| < 1 / 2) :
    ∃ lowerBits integerBits : List Bool, ∃ guard : Bool,
      lowerBits.length + 1 = precision ∧ integerBits.length = (signedLowBits ++ [sign]).length - precision ∧
      HoareTime (program (alphabet := alphabet))
        (· = input signedLowBits sign carryBits chunkWidth precision)
        (fun finalBank => finalBank = output signedLowBits sign lowerBits integerBits carryBits guard chunkWidth ∧
          Counter.value ((sumBits (roundedBits guard integerBits) carryBits).take chunkWidth) =
            (coefficient + Counter.value carryBits) % 2 ^ chunkWidth ∧
          Counter.value ((sumBits (roundedBits guard integerBits) carryBits).drop chunkWidth) =
            (coefficient + Counter.value carryBits) / 2 ^ chunkWidth)
        (13 * (signedLowBits ++ [sign]).length + 4 * carryBits.length + chunkWidth + 50) := by
  let magnitudeBits := RecoverMagnitude.magnitude signedLowBits sign
  let fractionalWord := magnitudeBits.take precision
  have magnitudeLength : magnitudeBits.length = (signedLowBits ++ [sign]).length :=
    RecoverMagnitude.magnitude_length signedLowBits sign
  have fractionalLength : fractionalWord.length = precision := by
    simp only [fractionalWord,List.length_take,magnitudeLength,Nat.min_eq_left precisionFits]
  have fractionalNonempty : fractionalWord ≠ [] := by
    intro empty
    rw [empty] at fractionalLength
    simp only [List.length_nil] at fractionalLength
    omega
  let lowerBits := fractionalWord.dropLast
  let guard := fractionalWord.getLast fractionalNonempty
  let integerBits := magnitudeBits.drop precision
  have fractionalLayout : lowerBits ++ [guard] = fractionalWord := List.dropLast_append_getLast fractionalNonempty
  have lowerLength : lowerBits.length + 1 = precision := by
    rw [← fractionalLayout] at fractionalLength
    simpa only [List.length_append,List.length_cons,List.length_nil] using fractionalLength
  have integerLength : integerBits.length = (signedLowBits ++ [sign]).length - precision := by
    simp only [integerBits,List.length_drop,magnitudeLength]
  have layout : RecoverMagnitude.magnitude signedLowBits sign = sourceBits lowerBits guard integerBits := by
    change magnitudeBits = (lowerBits ++ [guard]) ++ magnitudeBits.drop precision
    rw [fractionalLayout]
    exact (List.take_append_drop precision magnitudeBits).symm
  refine ⟨lowerBits,integerBits,guard,lowerLength,integerLength,?_⟩
  have execution := runs_signed (alphabet := alphabet) signedLowBits sign lowerBits integerBits carryBits guard
    coefficient chunkWidth layout (by rw [integerLength]; exact chunkFits)
    (by simpa only [lowerLength] using approximationClose)
  simpa only [lowerLength] using execution

end IntegerMultBounds.Machine.RecoverSignedCoefficient
