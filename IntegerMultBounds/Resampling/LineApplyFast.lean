    HoareTime programF (fun v => v = Schoenhage.blkAppend (Z (a := 0) wt arr s t m p w W L sW tW pXs pYs pP pP2 pO1 pO2 pRp pRw pR2 pF1 pF2 pA1 pA2 pRm pRW pCr pCs pCt pFc pRl pRx1 pRx2 pRk hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl 0))
