/-- The output words of line `ℓ`. -/
noncomputable def b0Out (arr wtE wtH wtD zeros : List (List Bool)) (s t m p w W ℓ : ℕ) : List (List Bool) :=
  oneStep wtD zeros s p w (iter wtE (oneStep wtH zeros s p w (vsel (line arr t ℓ) s t)) s m p w W p)

/-- The output words of the first `ℓ` lines. -/
noncomputable def b0Outs (arr wtE wtH wtD zeros : List (List Bool)) (s t m p w W : ℕ) : ℕ → List (List Bool)
  | 0 => []
  | ℓ + 1 => b0Outs arr wtE wtH wtD zeros s t m p w W ℓ ++ b0Out arr wtE wtH wtD zeros s t m p w W ℓ

theorem b0outs_tape (arr wtE wtH wtD zeros : List (List Bool)) (s t m p w W ℓ : ℕ) :
    putWord (fun _ => blank) 0 (flat (wordRecs (a := a) (b0Outs arr wtE wtH wtD zeros s t m p w W ℓ)) ++
      flat (wordRecs (a := a) (oneStep wtD zeros s p w (iter wtE (oneStep wtH zeros s p w (vsel (line arr t ℓ) s t)) s m p w W p)))) =
      putWord (fun _ => blank) 0 (flat (wordRecs (a := a) (b0Outs arr wtE wtH wtD zeros s t m p w W (ℓ + 1)))) := by
  simp only [b0Outs, b0Out, wordRecs, List.map_append, OrderedSelect.flat_append]

theorem b0outs_len (arr wtE wtH wtD zeros : List (List Bool)) (s t m p w W ℓ : ℕ) :
    ((flat (wordRecs (a := a) (b0Outs arr wtE wtH wtD zeros s t m p w W ℓ)) ++
      flat (wordRecs (a := a) (oneStep wtD zeros s p w (iter wtE (oneStep wtH zeros s p w (vsel (line arr t ℓ) s t)) s m p w W p)))).length : ℤ) =
      ((flat (wordRecs (a := a) (b0Outs arr wtE wtH wtD zeros s t m p w W (ℓ + 1)))).length : ℤ) := by
  simp only [b0Outs, b0Out, wordRecs, List.map_append, OrderedSelect.flat_append]

