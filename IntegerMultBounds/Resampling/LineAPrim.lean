    HoareTime progF (· = Schoenhage.enc (sigIn wt arr s t m p w W L sW tW))
      (· = Schoenhage.enc (sigOut wt arr s t m p w W L sW tW)) (progBound wt arr s t m p w W L sW tW) := by
  rw [enc_sigIn, enc_sigOut]; exact progF_hoare wt arr s t m p w W L sW tW hw hpw hwW hwt hwtl harr harrw hms hst hs hsv htv hsl

