theorem wordAt_ones (n : ℕ) : wordAt (a := 0) (ones n) = putWord (fun _ => blank) 0 (ruler n) := by
  rw [Schoenhage.wordAt_eq, Schoenhage.ruler_ones]

theorem wordAt_bits (bs : List Bool) : wordAt (a := 0) bs = putWord (fun _ => blank) 0 (bs.map bitSymbol) :=
  Schoenhage.wordAt_eq bs

theorem recsOf_wordRecs (ws : List (List Bool)) : recsOf (a := 0) ws = wordRecs ws := rfl

theorem outs_width (wt arr : List (List Bool)) (s t m p w W : ℕ) (hwW : w ≤ W) :
    ∀ L, ∀ x ∈ outs wt arr s t m p w W L, x.length = W
  | 0 => by simp [outs]
  | L + 1 => by
    intro x hx
    simp only [outs, List.mem_append] at hx
    rcases hx with hx | hx
    · exact outs_width wt arr s t m p w W hwW L x hx
    · exact NeumannStep.outWords_width _ _ _ _ _ _ _ _ _ hwW x hx

/-- Four tapes with heads. -/
def b4 (f0 f1 f2 f3 : ℤ → Fin 4) (p0 p1 p2 p3 : ℤ) : Tapes 4 0 :=
  ⟨fun i => if i = 0 then p0 else if i = 1 then p1 else if i = 2 then p2 else p3,
   fun i => if i = 0 then f0 else if i = 1 then f1 else if i = 2 then f2 else f3⟩

theorem b4_eq (f0 f1 f2 f3 : ℤ → Fin 4) : b4 f0 f1 f2 f3 0 0 0 0 = bank4 f0 f1 f2 f3 := by
  unfold b4 bank4; congr 1 <;> funext i <;> fin_cases i <;> rfl

theorem recordsToPaper_b4 {w : ℕ} (hw : 1 ≤ w) (ws : List (List Bool)) (hws : ∀ x ∈ ws, x.length = w) :
    HoareTime recordsToPaper (· = b4 (fun _ => blank) (wordAt (ones w)) (inTape (wordRecs ws)) (fun _ => blank) 0 0 0 0)
      (· = b4 (wordAt (msbArray ws)) (wordAt (ones w)) (fun _ => blank) (fun _ => blank) 0 0 0 0)
      (ws.length * (8 * w + 40) + 40 * Schoenhage.clen ws + 4 * w + 150) := by
  rw [b4_eq, b4_eq]; exact recordsToPaper_hoare hw ws hws

